{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "Task"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "linear"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/KittyEnvPersist.hook.ts"
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/LoadContext.hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/AgentExecutionGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/SkillGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/SetQuestionTab.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/RatingCapture.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/SessionAutoName.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/UpdateTabTitle.hook.ts",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/prd-sync.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/memory-feed.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/glob-rules.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/QuestionAnswered.hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/stop-guard.sh"
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/LastResponseCache.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/VoiceCompletion.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/DocIntegrity.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/ResponseTabReset.hook.ts",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/WorkCompletionLearning.hook.ts"
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/RelationshipMemory.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/IntegrityCheck.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/UpdateCounts.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "bun run $HOLOCRON_MEMORY_DIR/hooks/SessionCleanup.hook.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "theme": "auto"
}
