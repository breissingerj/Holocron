{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HOLOCRON_MEMORY_DIR": "/Users/jbreissinger/Projects/personalProjects/holocron-context"
  },
  "permissions": {
    "allow": ["Bash", "Read", "Write", "Edit", "MultiEdit", "Glob", "Grep", "WebFetch", "Task"],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/KittyEnvPersist.hook.ts"
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/LoadContext.hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/AgentExecutionGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/SecurityValidator.hook.ts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/SkillGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/SetQuestionTab.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/RatingCapture.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/SessionAutoName.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/UpdateTabTitle.hook.ts",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/prd-sync.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/memory-feed.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/glob-rules.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/QuestionAnswered.hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/stop-guard.sh"
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/LastResponseCache.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/VoiceCompletion.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/DocIntegrity.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/ResponseTabReset.hook.ts",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/WorkCompletionLearning.hook.ts"
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/RelationshipMemory.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/IntegrityCheck.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/UpdateCounts.hook.ts",
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/jbreissinger/.bun/bin/bun run /Users/jbreissinger/Projects/personalProjects/holocron-context/hooks/SessionCleanup.hook.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["linear"]
}
